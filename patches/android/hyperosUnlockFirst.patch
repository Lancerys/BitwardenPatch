+    /**
+     * A generic entry gives no site-specific information before the vault is unlocked.
+     * Once unlocked, use the real RP ID and allowCredentials list to display ONLY
+     * matching stored passkeys. Actual signing still uses Bitwarden's origin validation.
+     */
+    private fun DataState<VaultData>.filterForGenericPasskeyIfNecessary(): DataState<VaultData> {
+        val request = state.fido2CredentialAssertionRequest
+            ?.takeIf { it.cipherId == HYPEROS_UNLOCK_FIRST_SENTINEL_CIPHER_ID }
+            ?: return this
+        val option = request.option
+        val relyingPartyId = option?.let { relyingPartyParser.parse(it) }
+        val allowedIds = option?.requestJson
+            ?.let { runCatching { JSONObject(it) }.getOrNull() }
+            ?.optJSONArray("allowCredentials")
+            ?.let { array ->
+                buildSet {
+                    for (index in 0 until array.length()) {
+                        array.optJSONObject(index)
+                            ?.optString("id")
+                            ?.takeIf { it.isNotBlank() }
+                            ?.trimEnd('=')
+                            ?.let { add(it) }
+                    }
+                }
+            }
+            .orEmpty()
+        return this.map { vaultData ->
+            vaultData.copy(
+                decryptCipherListResult = vaultData.decryptCipherListResult.copy(
+                    successes = vaultData.decryptCipherListResult.successes.filter { cipher ->
+                        cipher.isActiveWithFido2Credentials &&
+                            (cipher.type as? CipherListViewType.Login)
+                                ?.v1
+                                ?.fido2Credentials
+                                .orEmpty()
+                                .any { credential ->
+                                    credential.rpId == relyingPartyId &&
+                                        (allowedIds.isEmpty() ||
+                                            credential.credentialId.toBase64UrlIdOrNull() in allowedIds)
+                                }
+                    },
+                    failures = emptyList(),
+                ),
+            )
+        }
+    }
+
