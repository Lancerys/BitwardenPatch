+                Base64.encodeToString(
+                    ByteBuffer.allocate(16)
+                        .putLong(uuid.mostSignificantBits)
+                        .putLong(uuid.leastSignificantBits)
+                        .array(),
+                    Base64.URL_SAFE or Base64.NO_WRAP or Base64.NO_PADDING,
+                )
+            }
+        }
